!use sparkfunc
!set outputformat mysql

# EXISTS
select "EXISTS"(array(1,2,3), x -> x = 2);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

select "EXISTS"(array(1,2,3), x -> x = 4);
+--------+
| EXPR$0 |
+--------+
| false  |
+--------+
(1 row)

!ok

select "EXISTS"(array(1,2,3), x -> x > 2 and x < 4);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

select "EXISTS"(array(1,2,3), x -> power(x, 2) = 9);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

select "EXISTS"(array(-1,-2,-3), x -> abs(x) = 0);
+--------+
| EXPR$0 |
+--------+
| false  |
+--------+
(1 row)

!ok

select "EXISTS"(array(1,2,3), x -> cast(null as boolean));
+--------+
| EXPR$0 |
+--------+
|        |
+--------+
(1 row)

!ok

select "EXISTS"(cast(null as integer array), x -> cast(null as boolean));
+--------+
| EXPR$0 |
+--------+
|        |
+--------+
(1 row)

!ok

select "EXISTS"(array[1, 2, 3], 1);
Cannot apply 'EXISTS' to arguments of type 'EXISTS(<INTEGER ARRAY>, <INTEGER>)'
!error

select "EXISTS"(array[array[1, 2], array[3, 4]], x -> x[1] = 1);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# [CALCITE-7269] SqlValidator throws exception if lambda parameter is struct
select "EXISTS"(array(ROW(true, false)), x -> x."EXPR$1");
+--------+
| EXPR$0 |
+--------+
| false  |
+--------+
(1 row)

!ok

select "EXISTS"(array(ROW(1, 2)), x -> x."EXPR$1" > 1);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# Nested access path within the lambda
select "EXISTS"(array(ROW(ROW(1, 2), 3)), x -> x."EXPR$0"."EXPR$1" > 1);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok


# Deeply nested element accessed through a correlated array
select (select "EXISTS"(t.arr, x -> x."EXPR$0"."EXPR$0"."EXPR$1" = 2) from (values (0)))
from (select array(ROW(ROW(ROW(1, 2), 3), 4)) as arr) as t;
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# Same access without correlation
select "EXISTS"(array(ROW(ROW(ROW(1, 2), 3), 4)), x -> x."EXPR$0"."EXPR$0"."EXPR$1" = 2);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# Lambda over an ARRAY(subquery) whose element is a nested struct; the
# flattener splits the subquery columns and restructures them back under
# the Collect, so the element type and the lambda are unchanged
select "EXISTS"(array(select ROW(ROW(1, 2), 3) from (values (0))),
    x -> x."EXPR$0"."EXPR$1" = 2);
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# The same nested ROW value used inside a lambda (capture) and outside of
# it (field extraction); both uses must see the same shape
select "EXISTS"(array(1, 2), x -> x = t.r."EXPR$0"."EXPR$1") as e,
    t.r."EXPR$0"."EXPR$0" as v
from (select ROW(ROW(1, 2), 3) as r) as t;
+------+---+
| E    | V |
+------+---+
| true | 1 |
+------+---+
(1 row)

!ok

# The same array used inside a lambda and outside of it; both uses must
# see the same element shape
select "EXISTS"(a.arr, x -> x."EXPR$0"."EXPR$1" = 2) as e,
    cardinality(a.arr) as c,
    a.arr[1]."EXPR$0"."EXPR$1" as v
from (select array(ROW(ROW(1, 2), 3)) as arr) as a;
+------+---+---+
| E    | C | V |
+------+---+---+
| true | 1 | 2 |
+------+---+---+
(1 row)

!ok


# [CALCITE-6242] Enhance lambda closure parsing
select *
 from (select array(1, 2, 3) as arr) as t1 inner join
     (select 1 as v) as t2 on "EXISTS"(arr, x -> x = t2.v);
+-----------+---+
| ARR       | V |
+-----------+---+
| [1, 2, 3] | 1 |
+-----------+---+
(1 row)

!ok

# Nested lambda: x -> (y -> x + y).
# The inner closure 'x' refers to the outer lambda parameter,
# and must not be treated like a table column name.
# For x in (1,2,3) and y in (1,2,3), x + y = 4 holds (e.g. 1+3, 2+2, 3+1).
select "EXISTS"(array(1, 2, 3), x -> "EXISTS"(array(1, 2, 3), y -> x + y = 4));
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# Nested lambda with a FROM clause whose column is also named 'x'.
# The inner closure 'x' must resolve to the outer lambda parameter
# (values 1,2,3), NOT to the table column 'x' (value 100).
# If 'x' were resolved as the column, 100 + y = 4 would never hold
# and the result would be false.
select "EXISTS"(array(1, 2, 3), x -> "EXISTS"(array(1, 2, 3), y -> x + y = 4)) as r
 from (select 100 as x) as t;
+------+
| R    |
+------+
| true |
+------+
(1 row)

!ok

# [CALCITE-7718] Lambda capturing ROW field crashes at compilation with
# assertion failure.
# Lambda captures a field of a struct value from the enclosing query.
select "EXISTS"(array(1, 2), x -> x = t.r."EXPR$0") from (select ROW(1, 2) as r) as t;
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# Same, but the captured struct is built from table columns
# Jane is in dept 10
select "EXISTS"(array(5, 10), x -> x = t.r."EXPR$0")
from (select ROW(deptno, 1) as r from emp where ename = 'Jane') as t;
+--------+
| EXPR$0 |
+--------+
| true   |
+--------+
(1 row)

!ok

# [CALCITE-7933] Correlated subqueries with lambdas that capture columns are
# incorrectly compiled
#
# The results of the tests in this section were validated with Spark 3.5.9
# and DuckDB 2.0.0. Spark runs each query with array(...) for array[...].
# In DuckDB, EXISTS(a, e -> p) is spark_exists(list_transform(a, lambda e: p)),
# where the macro spark_exists has the rule of Spark: TRUE if one element
# gives TRUE, else NULL if one element gives NULL, else FALSE.

# The lambda in the WHERE clause of a scalar sub-query compares the array
# elements with t.x of the enclosing query.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select (select count(*) from (values (array[1, 2])) as s(b)
        where "EXISTS"(s.b, e -> e = t.x)) as c
from (values (1)) as t(x);
+---+
| C |
+---+
| 1 |
+---+
(1 row)

!ok

# Same, but the first column of the sub-query input has the type of t.x.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select t.x,
  (select count(*) from (values (5, array[1, 5]), (6, array[1])) as s(y, b)
   where "EXISTS"(s.b, e -> e = t.x)) as c
from (values (1), (7)) as t(x);
+---+---+
| X | C |
+---+---+
| 1 | 2 |
| 7 | 0 |
+---+---+
(2 rows)

!ok

# The lambda is in the SELECT list of the sub-query.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select t.x,
  (select "EXISTS"(s.b, e -> e = t.x) from (values (array[1, 5])) as s(b)) as c
from (values (1), (7)) as t(x);
+---+-------+
| X | C     |
+---+-------+
| 1 | true  |
| 7 | false |
+---+-------+
(2 rows)

!ok

# The lambda references a column of the sub-query (s.y) and a column of the
# enclosing query (t.x).
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select t.x,
  (select count(*) from (values (1, array[1, 5]), (4, array[1])) as s(y, b)
   where "EXISTS"(s.b, e -> e = t.x + s.y)) as c
from (values (0), (1)) as t(x);
+---+---+
| X | C |
+---+---+
| 0 | 1 |
| 1 | 0 |
+---+---+
(2 rows)

!ok

# The inner lambda of a nested lambda references a column of the enclosing
# query.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select t.x,
  (select count(*) from (values (array[1, 2])) as s(b)
   where "EXISTS"(s.b, e -> "EXISTS"(array[3], f -> e + f = t.x))) as c
from (values (4), (6)) as t(x);
+---+---+
| X | C |
+---+---+
| 4 | 1 |
| 6 | 0 |
+---+---+
(2 rows)

!ok

# The lambda is in a sub-query of a sub-query, and references a column of the
# outermost query.
# Result validated with DuckDB 2.0.0. Spark 3.5.9 rejects this query,
# because it cannot resolve t.x two query levels up.
select t.x,
  (select count(*) from (values (10), (20)) as u(z)
   where exists (select 1 from (values (array[1, 5])) as s(b)
                 where "EXISTS"(s.b, e -> e = t.x))) as c
from (values (1), (7)) as t(x);
+---+---+
| X | C |
+---+---+
| 1 | 2 |
| 7 | 0 |
+---+---+
(2 rows)

!ok

# The lambda is in a correlated EXISTS sub-query in the WHERE clause.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select t.x
from (values (1), (7)) as t(x)
where exists (select 1 from (values (array[1, 5])) as s(b)
              where "EXISTS"(s.b, e -> e = t.x));
+---+
| X |
+---+
| 1 |
+---+
(1 row)

!ok

# The lambda in a JOIN ON condition reads a column of the other input.
# The inputs have more than one row, so the condition is not folded.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select *
from (values (array[1, 2, 3]), (array[4])) as t1(arr)
inner join (values (1), (4)) as t2(v) on "EXISTS"(arr, x -> x = t2.v);
+-----------+---+
| ARR       | V |
+-----------+---+
| [1, 2, 3] | 1 |
| [4]       | 4 |
+-----------+---+
(2 rows)

!ok

# The lambda is in the FROM clause, in a LATERAL sub-query, and references a
# column of the preceding FROM item.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select *
from (values (1), (5)) as b(v),
  lateral (select "EXISTS"(array[1, 2], e -> e = b.v) as r
           from (values (0)) as z(z));
+---+-------+
| V | R     |
+---+-------+
| 1 | true  |
| 5 | false |
+---+-------+
(2 rows)

!ok

# The lambda in the SELECT list of an aggregate query reads a GROUP BY
# column. K2 is column 1 of the FROM clause, but column 0 of the
# aggregate result.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2, k3, "EXISTS"(array[1, 2], e -> e = k2) as r
from (values (0, 1, 5), (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by k2, k3;
+----+----+-------+
| K2 | K3 | R     |
+----+----+-------+
|  1 |  5 | true  |
|  3 |  2 | false |
+----+----+-------+
(2 rows)

!ok

# The aggregate result has only one column.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2, "EXISTS"(array[1, 2], e -> e = k2) as r
from (values (0, 1), (0, 1), (0, 3)) as t(k1, k2)
group by k2;
+----+-------+
| K2 | R     |
+----+-------+
|  1 | true  |
|  3 | false |
+----+-------+
(2 rows)

!ok

# The lambda in the HAVING clause reads a GROUP BY column.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2, count(*) as c
from (values (0, 1, 5), (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by k2, k3
having "EXISTS"(array[1, 2], e -> e = k3);
+----+---+
| K2 | C |
+----+---+
|  3 | 1 |
+----+---+
(1 row)

!ok

# A nested lambda reads a GROUP BY column.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2,
  "EXISTS"(array[array[1], array[4]], a -> "EXISTS"(a, e -> e = k2)) as r
from (values (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by k2, k3;
+----+-------+
| K2 | R     |
+----+-------+
|  1 | true  |
|  3 | false |
+----+-------+
(2 rows)

!ok

# The lambda reads a GROUP BY expression.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2 + 1 as p, "EXISTS"(array[2, 3], e -> e = k2 + 1) as r
from (values (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by k2 + 1;
+---+-------+
| P | R     |
+---+-------+
| 2 | true  |
| 4 | false |
+---+-------+
(2 rows)

!ok

# With ROLLUP, K3 is null in the subtotal rows.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select k2, k3, "EXISTS"(array[2], e -> e = k3) as r
from (values (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by rollup(k2, k3);
+----+----+-------+
| K2 | K3 | R     |
+----+----+-------+
|  1 |  5 | false |
|  1 |    |       |
|  3 |  2 | true  |
|  3 |    |       |
|    |    |       |
+----+----+-------+
(5 rows)

!ok

# A lambda in a sub-query reads a GROUP BY column of the enclosing query.
# Result validated with DuckDB 2.0.0. Spark 3.5.9 rejects this query,
# because a correlated scalar sub-query in an aggregate query must be in
# GROUP BY or in an aggregate function.
select k2,
  (select count(*) from (values (array[1, 3]), (array[1])) as s(b)
   where "EXISTS"(s.b, e -> e = t.k2)) as c
from (values (0, 1, 5), (0, 1, 5), (0, 3, 2)) as t(k1, k2, k3)
group by k2, k3;
+----+---+
| K2 | C |
+----+---+
|  1 | 2 |
|  3 | 1 |
+----+---+
(2 rows)

!ok

# A lambda in ORDER BY can read its parameter, but not a column.
# The parameter E has the same name as a select item, and E in the
# lambda is the parameter. The lambda reads the column A only through
# its array argument.
# Result validated with Spark 3.5.9 and DuckDB 2.0.0.
select x as e from (values (1, array[1]), (3, array[2])) as t(x, a)
order by "EXISTS"(a, e -> e = 2) desc, "EXISTS"(array[1, 2], e -> e = 1);
+---+
| E |
+---+
| 3 |
| 1 |
+---+
(2 rows)

!ok
