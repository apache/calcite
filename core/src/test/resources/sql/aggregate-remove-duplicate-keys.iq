!use post
!set outputformat mysql

# [CALCITE-7757] RelMdFunctionalDependency can infer unsound dependencies
# and cause incorrect query results.
#
# The result sets in this file were cross-validated with PostgreSQL 18.6.

!set hep-rules "
+CoreRules.AGGREGATE_REMOVE_DUPLICATE_KEYS"

# A LEFT JOIN equality implies left_key -> right_key, but not the reverse.
# If the rule used the invalid reverse dependency, it would group only by
# right_key and collapse the two unmatched rows into one row with N = 2.
with l(k) as (values (1), (2), (3)),
    r(k) as (values (1))
select r.k as right_key, l.k as left_key, count(*) as n
from l
left join r on l.k = r.k
group by r.k, l.k
order by left_key;
+-----------+----------+---+
| RIGHT_KEY | LEFT_KEY | N |
+-----------+----------+---+
|         1 |        1 | 1 |
|           |        2 | 1 |
|           |        3 | 1 |
+-----------+----------+---+
(3 rows)

!ok
EnumerableSort(sort0=[$1], dir0=[ASC])
  EnumerableAggregate(group=[{0, 1}], N=[COUNT()])
    EnumerableCalc(expr#0..1=[{inputs}], RIGHT_KEY=[$t1], LEFT_KEY=[$t0])
      EnumerableMergeJoin(condition=[=($0, $1)], joinType=[left])
        EnumerableValues(tuples=[[{ 1 }, { 2 }, { 3 }]])
        EnumerableValues(tuples=[[{ 1 }]])
!plan

# The right Project implies a -> y before the LEFT JOIN. Null padding creates
# both (a, y) = (NULL, NULL) and (NULL, 1), invalidating that dependency. If
# the rule preserved it, the two groups would be collapsed into one row.
with l(z) as (values (1), (2)),
    r(z, a, y) as (
      select z, a, coalesce(a, 1)
      from (values (1, cast(null as integer))) as v(z, a))
select r.a, r.y, count(*) as n
from l
left join r on l.z = r.z
group by r.a, r.y
order by r.y nulls first;
+---+---+---+
| A | Y | N |
+---+---+---+
|   |   | 1 |
|   | 1 | 1 |
+---+---+---+
(2 rows)

!ok
EnumerableSort(sort0=[$1], dir0=[ASC-nulls-first])
  EnumerableAggregate(group=[{0, 1}], N=[COUNT()])
    EnumerableCalc(expr#0..3=[{inputs}], A=[$t2], Y=[$t3])
      EnumerableHashJoin(condition=[=($0, $1)], joinType=[left])
        EnumerableValues(tuples=[[{ 1 }, { 2 }]])
        EnumerableCalc(expr#0..1=[{inputs}], expr#2=[IS NOT NULL($t1)], expr#3=[CAST($t1):INTEGER NOT NULL], expr#4=[1], expr#5=[CASE($t2, $t3, $t4)], proj#0..1=[{exprs}], EXPR$2=[$t5])
          EnumerableValues(tuples=[[{ 1, null }]])
!plan

!set hep-rules original
!set hep-rules "
+CoreRules.AGGREGATE_PROJECT_MERGE,
+CoreRules.AGGREGATE_REMOVE_DUPLICATE_KEYS"

# AggregateProjectMergeRule makes input ordinals 1, 2, and 3 the group keys.
# The a -> b dependency must be mapped from input ordinals 1 -> 2 to aggregate
# output ordinals 0 -> 1. Mapping it incorrectly could remove c and collapse
# the two rows below into one row with N = 2.
select a, b, c, count(*) as n
from (values (0, 1, 1, 10), (0, 1, 1, 20)) as t(z, a, b, c)
where a = b
group by a, b, c
order by c;
+---+---+----+---+
| A | B | C  | N |
+---+---+----+---+
| 1 | 1 | 10 | 1 |
| 1 | 1 | 20 | 1 |
+---+---+----+---+
(2 rows)

!ok
EnumerableSort(sort0=[$2], dir0=[ASC])
  EnumerableCalc(expr#0..3=[{inputs}], A=[$t0], B=[$t2], C=[$t1], N=[$t3])
    EnumerableAggregate(group=[{1, 3}], B=[ANY_VALUE($2)], N=[COUNT()])
      EnumerableCalc(expr#0..3=[{inputs}], expr#4=[=($t1, $t2)], proj#0..3=[{exprs}], $condition=[$t4])
        EnumerableValues(tuples=[[{ 0, 1, 1, 10 }, { 0, 1, 1, 20 }]])
!plan

!set hep-rules original

# End aggregate-remove-duplicate-keys.iq
