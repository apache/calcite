# ROW values with NULL fields.

# MEMBER OF
SELECT id, ROW(x, CAST(NULL AS INTEGER)) MEMBER OF MULTISET[ROW(z, CAST(NULL AS INTEGER))] AS r
FROM (VALUES
    (1, 1, 1),
    (2, 2, 3)) AS t(id, x, z)
ORDER BY id;
+----+-------+
| ID | R     |
+----+-------+
|  1 | true  |
|  2 | false |
+----+-------+
(2 rows)

!ok

# IS A SET and IS NOT A SET
SELECT id,
    MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER))] IS A SET AS r,
    MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER))] IS NOT A SET AS not_r
FROM (VALUES
    (1, 1, 1),
    (2, 2, 3)) AS t(id, x, z)
ORDER BY id;
+----+-------+-------+
| ID | R     | NOT_R |
+----+-------+-------+
|  1 | false | true  |
|  2 | true  | false |
+----+-------+-------+
(2 rows)

!ok

# SUBMULTISET OF and NOT SUBMULTISET OF
SELECT id,
    MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(x, CAST(NULL AS INTEGER))]
        SUBMULTISET OF MULTISET[ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(9, CAST(NULL AS INTEGER))] AS r,
    MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(x, CAST(NULL AS INTEGER))]
        NOT SUBMULTISET OF MULTISET[ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(9, CAST(NULL AS INTEGER))] AS not_r
FROM (VALUES
    (1, 1, 1),
    (2, 2, 3)) AS t(id, x, z)
ORDER BY id;
+----+-------+-------+
| ID | R     | NOT_R |
+----+-------+-------+
|  1 | true  | false |
|  2 | false | true  |
+----+-------+-------+
(2 rows)

!ok

# Equal input cardinalities, but too few occurrences of the requested row.
SELECT id, MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(x, CAST(NULL AS INTEGER))]
    SUBMULTISET OF MULTISET[ROW(z, CAST(NULL AS INTEGER)), ROW(9, CAST(NULL AS INTEGER))] AS r
FROM (VALUES
    (1, 1, 1),
    (2, 2, 3)) AS t(id, x, z)
ORDER BY id;
+----+-------+
| ID | R     |
+----+-------+
|  1 | false |
|  2 | false |
+----+-------+
(2 rows)

!ok

# MULTISET INTERSECT ALL
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, CAST(NULL AS INTEGER)), ROW(x, CAST(NULL AS INTEGER)), ROW(9, CAST(NULL AS INTEGER))]
        MULTISET INTERSECT ALL
        MULTISET[ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(z, CAST(NULL AS INTEGER)), ROW(8, CAST(NULL AS INTEGER))] AS m
    FROM (VALUES
        (1, 1, 1),
        (2, 2, 3)) AS t(id, x, z)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+-----------+
| ID | R         |
+----+-----------+
|  1 | {1, null} |
|  1 | {1, null} |
+----+-----------+
(2 rows)

!ok

