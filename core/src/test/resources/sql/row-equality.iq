# Test cases for https://issues.apache.org/jira/browse/CALCITE-7842
# [CALCITE-7842] Multiset operators return incorrect results for ROW elements
# All 31 queries below were checked against Oracle using OneCompiler.
# The Oracle adaptation used object types in place of ROW values and nested
# table types in place of MULTISET literals. Explicit MAP methods compared
# object fields, treating corresponding NULL fields as equal.
# All 217 result rows matched after ordering by case id and element fields.
!use scott

# Original MEMBER OF reproduction.
SELECT ROW(1, 'Foo') MEMBER OF MULTISET[ROW(x, y)] AS r
FROM (VALUES (1, 'Foo'), (2, 'Bar')) AS t(x, y);
+-------+
| R     |
+-------+
| true  |
| false |
+-------+
(2 rows)

!ok

# Flat ROW values.

# MEMBER OF
SELECT id, ROW(x, y) MEMBER OF MULTISET[ROW(z, w)] AS r
FROM (VALUES
    (1, 1, 'Foo', 1, 'Foo'),
    (2, 2, 'Bar', 2, 'Car'),
    (3, 3, 'Baz', 4, 'Baz'),
    (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)
ORDER BY id;
+----+-------+
| ID | R     |
+----+-------+
|  1 | true  |
|  2 | false |
|  3 | false |
|  4 | true  |
+----+-------+
(4 rows)

!ok

# IS A SET and IS NOT A SET
SELECT id,
    MULTISET[ROW(x, y), ROW(z, w)] IS A SET AS r,
    MULTISET[ROW(x, y), ROW(z, w)] IS NOT A SET AS not_r
FROM (VALUES
    (1, 1, 'Foo', 1, 'Foo'),
    (2, 2, 'Bar', 2, 'Car'),
    (3, 3, 'Baz', 4, 'Baz'),
    (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)
ORDER BY id;
+----+-------+-------+
| ID | R     | NOT_R |
+----+-------+-------+
|  1 | false | true  |
|  2 | true  | false |
|  3 | true  | false |
|  4 | false | true  |
+----+-------+-------+
(4 rows)

!ok

# SUBMULTISET OF and NOT SUBMULTISET OF
SELECT id,
    MULTISET[ROW(x, y), ROW(x, y)]
        SUBMULTISET OF MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(9, 'Zzz')] AS r,
    MULTISET[ROW(x, y), ROW(x, y)]
        NOT SUBMULTISET OF MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(9, 'Zzz')] AS not_r
FROM (VALUES
    (1, 1, 'Foo', 1, 'Foo'),
    (2, 2, 'Bar', 2, 'Car'),
    (3, 3, 'Baz', 4, 'Baz'),
    (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)
ORDER BY id;
+----+-------+-------+
| ID | R     | NOT_R |
+----+-------+-------+
|  1 | true  | false |
|  2 | false | true  |
|  3 | false | true  |
|  4 | true  | false |
+----+-------+-------+
(4 rows)

!ok

# Equal input cardinalities, but too few occurrences of the requested row.
SELECT id, MULTISET[ROW(x, y), ROW(x, y)]
    SUBMULTISET OF MULTISET[ROW(z, w), ROW(9, 'Zzz')] AS r
FROM (VALUES
    (1, 1, 'Foo', 1, 'Foo'),
    (2, 2, 'Bar', 2, 'Car'),
    (3, 3, 'Baz', 4, 'Baz'),
    (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)
ORDER BY id;
+----+-------+
| ID | R     |
+----+-------+
|  1 | false |
|  2 | false |
|  3 | false |
|  4 | false |
+----+-------+
(4 rows)

!ok

# MULTISET INTERSECT ALL
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET INTERSECT ALL
        MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(8, 'Yyy')] AS m
    FROM (VALUES
        (1, 1, 'Foo', 1, 'Foo'),
        (2, 2, 'Bar', 2, 'Car'),
        (3, 3, 'Baz', 4, 'Baz'),
        (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+-----------+
| ID | R         |
+----+-----------+
|  1 | {1, Foo}  |
|  1 | {1, Foo}  |
|  4 | {5, null} |
|  4 | {5, null} |
+----+-----------+
(4 rows)

!ok

# MULTISET INTERSECT DISTINCT
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET INTERSECT DISTINCT
        MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(8, 'Yyy')] AS m
    FROM (VALUES
        (1, 1, 'Foo', 1, 'Foo'),
        (2, 2, 'Bar', 2, 'Car'),
        (3, 3, 'Baz', 4, 'Baz'),
        (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+-----------+
| ID | R         |
+----+-----------+
|  1 | {1, Foo}  |
|  4 | {5, null} |
+----+-----------+
(2 rows)

!ok

# MULTISET EXCEPT ALL
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET EXCEPT ALL
        MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(8, 'Yyy')] AS m
    FROM (VALUES
        (1, 1, 'Foo', 1, 'Foo'),
        (2, 2, 'Bar', 2, 'Car'),
        (3, 3, 'Baz', 4, 'Baz'),
        (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+----------+
| ID | R        |
+----+----------+
|  1 | {9, Zzz} |
|  2 | {2, Bar} |
|  2 | {2, Bar} |
|  2 | {9, Zzz} |
|  3 | {3, Baz} |
|  3 | {3, Baz} |
|  3 | {9, Zzz} |
|  4 | {9, Zzz} |
+----+----------+
(8 rows)

!ok

# MULTISET EXCEPT DISTINCT
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET EXCEPT DISTINCT
        MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(8, 'Yyy')] AS m
    FROM (VALUES
        (1, 1, 'Foo', 1, 'Foo'),
        (2, 2, 'Bar', 2, 'Car'),
        (3, 3, 'Baz', 4, 'Baz'),
        (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+----------+
| ID | R        |
+----+----------+
|  1 | {9, Zzz} |
|  2 | {2, Bar} |
|  2 | {9, Zzz} |
|  3 | {3, Baz} |
|  3 | {9, Zzz} |
|  4 | {9, Zzz} |
+----+----------+
(6 rows)

!ok

# MULTISET UNION DISTINCT
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET UNION DISTINCT
        MULTISET[ROW(z, w), ROW(z, w), ROW(z, w), ROW(8, 'Yyy')] AS m
    FROM (VALUES
        (1, 1, 'Foo', 1, 'Foo'),
        (2, 2, 'Bar', 2, 'Car'),
        (3, 3, 'Baz', 4, 'Baz'),
        (4, 5, NULL, 5, NULL)) AS t(id, x, y, z, w)) AS t
CROSS JOIN UNNEST(m) AS u(a, b)
ORDER BY id, a, b;
+----+-----------+
| ID | R         |
+----+-----------+
|  1 | {1, Foo}  |
|  1 | {8, Yyy}  |
|  1 | {9, Zzz}  |
|  2 | {2, Bar}  |
|  2 | {2, Car}  |
|  2 | {8, Yyy}  |
|  2 | {9, Zzz}  |
|  3 | {3, Baz}  |
|  3 | {4, Baz}  |
|  3 | {8, Yyy}  |
|  3 | {9, Zzz}  |
|  4 | {5, null} |
|  4 | {8, Yyy}  |
|  4 | {9, Zzz}  |
+----+-----------+
(14 rows)

!ok

# MULTISET UNION ALL
SELECT id, ROW(a, b) AS r
FROM (
    SELECT id,
        MULTISET[ROW(x, y), ROW(x, y), ROW(9, 'Zzz')]
        MULTISET UNION ALL
