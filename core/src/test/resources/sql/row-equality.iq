# Nested ROW values.

# MEMBER OF
SELECT id, ROW(ROW(x, y), p) MEMBER OF MULTISET[ROW(ROW(z, w), q)] AS r
FROM (VALUES
    (1, 1, 'Foo', 10, 1, 'Foo', 10),
    (2, 2, 'Bar', 10, 2, 'Car', 10),
    (3, 3, 'Baz', 10, 4, 'Baz', 10),
    (4, 5, NULL, 10, 5, NULL, 10),
    (5, 6, 'Qux', 10, 6, 'Qux', 11)) AS t(id, x, y, p, z, w, q)
ORDER BY id;
+----+-------+
| ID | R     |
+----+-------+
|  1 | true  |
|  2 | false |
|  3 | false |
|  4 | true  |
|  5 | false |
+----+-------+
(5 rows)

!ok

